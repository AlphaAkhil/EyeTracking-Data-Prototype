  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '    This prototype demonstrates a <B>VR-based eye-tracking</B> data collection
    system developed in Unity using VIVE OpenXR. It captures real-time eye position,
    rotation, pupil diameter, eye openness, gaze direction, and viewed objects. The
    collected data is visualized during runtime and recorded into CSV files for analysis.
    This prototype showcases eye-tracking data acquisition, processing, visualization,
    and recording without using proprietary project code or assets.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
